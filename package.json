{
  "name": "express-crud-api",
  "version": "1.0.0",
  "description": "Simple CRUD REST API using Express.js and TypeScript",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "cspell": "cspell \"src/**/*.{ts,js}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write",
      "cspell --no-must-find-files --no-progress"
    ]
  },
  "keywords": [
    "express",
    "crud",
    "rest-api",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.27",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^4.19.2",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "cspell": "^10.3.6",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
